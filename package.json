{
  "name": "express-prisma-railway-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Express 5 + Prisma 7 starter for Railway, with migrations in the pre-deploy step",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
